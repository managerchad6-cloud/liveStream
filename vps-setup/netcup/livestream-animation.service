[Unit]
Description=LiveStream Animation Server (port 3003)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=livestream
Group=livestream
WorkingDirectory=/opt/livestream/animation-server
# server.js loads ../.env itself
ExecStart=/usr/bin/node /opt/livestream/animation-server/server.js
Environment=NODE_ENV=production
Environment=ANIMATION_PORT=3003
# 4 dedicated cores: let libvips use all of them (compositor defaults to 2 on Linux)
Environment=UV_THREADPOOL_SIZE=8
Environment=SHARP_CONCURRENCY=4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
